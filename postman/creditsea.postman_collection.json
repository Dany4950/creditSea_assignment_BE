{
  "info": {
    "name": "CreditSea API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "mobile",
      "value": "9876543210"
    },
    {
      "key": "adminKey",
      "value": "change-me-too"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "regToken",
      "value": ""
    },
    {
      "key": "loanId",
      "value": ""
    },
    {
      "key": "otp",
      "value": ""
    },
    {
      "key": "emailOtp",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health",
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Request OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/request-otp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"{{mobile}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('otp', pm.response.json().otp);"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify OTP (uses the OTP the server issued)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/verify-otp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"{{mobile}}\",\n  \"otp\": \"{{otp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('regToken', pm.response.json().registrationToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Set password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/set-password",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"{{mobile}}\",\n  \"password\": \"Test@1234\",\n  \"registrationToken\": \"{{regToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"{{mobile}}\",\n  \"password\": \"Test@1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout (all devices)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/logout",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "2. Onboarding",
      "item": [
        {
          "name": "Save personal",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/onboarding/personal",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Asha\",\n  \"lastName\": \"Rao\",\n  \"gender\": \"Female\",\n  \"dob\": \"1995-06-15\",\n  \"maritalStatus\": \"Single\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get personal",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/onboarding/personal"
          }
        },
        {
          "name": "Send email OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/onboarding/email/send-otp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"asha@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('emailOtp', pm.response.json().otp);"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify email (uses the OTP the server issued)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/onboarding/email/verify",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"asha@example.com\",\n  \"otp\": \"{{emailOtp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Verify PAN (ABCDE1234F => score 800)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/onboarding/pan/verify",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pan\": \"ABCDE1234F\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "3. Profile",
      "item": [
        {
          "name": "Get profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/user/profile"
          }
        },
        {
          "name": "Update profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/user/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Asha\",\n  \"maritalStatus\": \"Married\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "4. Loans",
      "item": [
        {
          "name": "Eligibility",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/loans/eligibility"
          }
        },
        {
          "name": "Quote",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/loans/quote",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 30000,\n  \"days\": 40\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Apply (creates the OFFER)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/loans/apply",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 30000,\n  \"days\": 40,\n  \"purpose\": \"Personal Needs\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('loanId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Accept offer (starts status engine)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/loans/{{loanId}}/accept",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "My loans (page 1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/loans?page=1&limit=10"
          }
        },
        {
          "name": "Loan detail (poll this)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/loans/{{loanId}}"
          }
        },
        {
          "name": "Repay (mock UPI) -> credit score changes",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/loans/{{loanId}}/repay",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"UPI\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "5. Admin (demo back-office)",
      "item": [
        {
          "name": "Approve",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}"
              }
            ],
            "url": "{{baseUrl}}/admin/loans/{{loanId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"approve\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Reject",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}"
              }
            ],
            "url": "{{baseUrl}}/admin/loans/{{loanId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"reject\",\n  \"reason\": \"Insufficient repayment history\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Disburse",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}"
              }
            ],
            "url": "{{baseUrl}}/admin/loans/{{loanId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"disburse\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Make overdue (then repay = late penalty)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-admin-key",
                "value": "{{adminKey}}"
              }
            ],
            "url": "{{baseUrl}}/admin/loans/{{loanId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"overdue\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    }
  ]
}