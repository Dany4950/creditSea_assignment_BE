# Copy to .env and fill in. NEVER commit .env
PORT=3000
NODE_ENV=development

# MongoDB Atlas connection string (replace user, password, cluster)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/creditsea?retryWrites=true&w=majority

# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=30d

# true  => OTP pool mode: no SMS provider, so each OTP request is answered with ONE random code from the pool below
#          (returned in the API response and shown in the app). Any code from the pool is accepted at verification.
# false => random OTPs; you must plug an SMS provider into src/services/otpService.js
DEMO_MODE=true

# The 5 codes kept on the server. Mobile: exactly 4 digits each. Email: exactly 6 digits each. Defaults are built in.
OTP_POOL_MOBILE=4821,7350,1946,6037,2584
OTP_POOL_EMAIL=482193,735028,194657,603714,258430

# Protects the demo endpoint that approves/rejects loans (header: x-admin-key). Leave empty to disable.
ADMIN_KEY=change-me-too

# Seconds between automatic loan status changes (8s => the whole flow takes about a minute)
STEP_DELAY_SECONDS=8

# Optional 64-char hex key for PAN encryption (defaults to a key derived from JWT_SECRET)
PAN_ENC_KEY=

# DEMO_MODE only: a loan of exactly this principal is rejected at review (shows the Rejected state). 0 disables.
DEMO_REJECT_AMOUNT=5000

# OPTIONAL: set these to send REAL email OTPs (e.g. Brevo / Gmail app-password SMTP). Leave empty to use the demo OTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CreditSea <no-reply@yourdomain.com>
